<Project>
  <PropertyGroup>
    <Authors Condition="'$(Authors)' == ''">Kevin Watkins</Authors>
    <Copyright>Copyright © Kevin Watkins</Copyright>
    <Nullable Condition="'$(Nullable)' == ''">enable</Nullable>
    <ImplicitUsings Condition="'$(ImplicitUsings)' == ''">enable</ImplicitUsings>
    <TreatWarningsAsErrors Condition="'$(TreatWarningsAsErrors)' == ''">true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild Condition="'$(EnforceCodeStyleInBuild)' == ''">true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile Condition="'$(GenerateDocumentationFile)' == ''">true</GenerateDocumentationFile>
    <IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>
    <ContinuousIntegrationBuild Condition="'$(ContinuousIntegrationBuild)' == '' And '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <IsTestProject Condition="'$(IsTestProject)' == '' And $(MSBuildProjectName.EndsWith('Tests'))">true</IsTestProject>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <EnableNUnitRunner Condition="'$(EnableNUnitRunner)' == ''">true</EnableNUnitRunner>
    <OutputType Condition="'$(OutputType)' == ''">Exe</OutputType>
    <TestingPlatformDotnetTestSupport Condition="'$(TestingPlatformDotnetTestSupport)' == ''">true</TestingPlatformDotnetTestSupport>
    <TestingPlatformShowTestsFailure Condition="'$(TestingPlatformShowTestsFailure)' == ''">true</TestingPlatformShowTestsFailure>
  </PropertyGroup>
</Project>
