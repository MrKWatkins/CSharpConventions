<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.0</Version>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageId>MrKWatkins.CSharpConventions</PackageId>
    <Description>Shared C# compiler, testing and packaging conventions.</Description>
    <Authors>Kevin Watkins</Authors>
    <Copyright>Copyright © Kevin Watkins</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/MrKWatkins/CSharpConventions</RepositoryUrl>
    <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
    <PackageReadmeFile>ReadMe.md</PackageReadmeFile>
    <PackageIcon>Icon.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Include="build/**" Pack="true" PackagePath="build/%(RecursiveDir)" />
    <None Include="config/**" Pack="true" PackagePath="config/%(RecursiveDir)" />
    <None Include="assets/Icon.png" Pack="true" PackagePath="assets/" />
    <None Include="assets/Icon.png" Pack="true" PackagePath="/" />
    <None Include="../../ReadMe.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
